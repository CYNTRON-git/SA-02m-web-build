# Shell scripts and CGI must use LF (Linux target)
*.sh    text eol=lf
# U-Boot boot script payloads: a CR reaches the kernel command line verbatim
# (docs/contracts/uboot-boot-script.md) and shifts the byte-exact size table.
boot.cmd.* text eol=lf
*.cgi   text eol=lf
*.conf  text eol=lf
*.rules text eol=lf
*.service text eol=lf
# logrotate rules are extensionless, so none of the pins above match them.
# A CRLF there makes logrotate exit 1 on every boot and take the whole run with
# it — this exact defect already shipped once (docs/bugs/BUGLOG.md,
# [2026-06-03 09:40]: "/etc/logrotate.d/sa02m-flasher имел CRLF-окончания →
# logrotate падал на каждом boot").
etc/logrotate.d/* text eol=lf

# Web files
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.svg   text eol=lf
*.json  text eol=lf

# Docs
*.md    text eol=lf
