[Unit]
Description=SA-02m expand rootfs to full eMMC after PiShrink clone
DefaultDependencies=no
After=local-fs.target
# Block only userspace watchdogs that would reboot during resize2fs.
# Do NOT Before=networking / ifupdown-pre / basic.target — that delayed
# link/SSH for the whole resize (2–5 min) and looked like "no boot".
# Armbian dual-resize is masked separately; single expand may run alongside ifup.
Before=sa02m-userspace-watchdog.service sa02m-failure-monitor.service net-watchdog.service
Conflicts=armbian-resize-filesystem.service
ConditionPathExists=!/var/lib/sa02m-rootfs-expand.done
ConditionPathExists=!/root/.no_rootfs_resize

[Service]
Type=oneshot
RemainAfterExit=yes
# resize2fs on ~8G eMMC typically 1–3 min; margin for slow media.
TimeoutStartSec=5min
ExecStart=/usr/local/sbin/sa02m-rootfs-expand.sh start
StandardOutput=journal
StandardError=journal
# TERM after successful resize must not leave the board degraded.
SuccessExitStatus=0 15 143

[Install]
WantedBy=multi-user.target
