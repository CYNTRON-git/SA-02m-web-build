# SA-02m flash stand — copy to stand.env and edit
#   cp stand.env.example stand.env

# IPv4 of this stand host on the factory LAN (baked into boot.scr / FEL script)
STAND_IP=192.168.1.10

# Optional: bind dnsmasq to one NIC (leave empty for all)
STAND_IFACE=

# DHCP pool for blank boards (disable if LAN already has authoritative DHCP:
# set ENABLE_DHCP=0 and rely on existing DHCP + fixed serverip in boot.scr)
ENABLE_DHCP=1
DHCP_RANGE_START=192.168.1.200
DHCP_RANGE_END=192.168.1.220
DHCP_NETMASK=255.255.255.0
DHCP_LEASE=2h

# HTTP port for current.img.xz
HTTP_PORT=8080

# Status UI
STATUS_PORT=8765

# Paths (relative to tools/imaging unless absolute)
# TFTP_ROOT=stand-data/tftpboot
# IMAGES_DIR=stand-data/images

# FEL USB vendor:product (Allwinner)
FEL_VID=1f3a
FEL_PID=efe8

# Post-flash QA
POSTFLASH_SSH_USER=root
POSTFLASH_SSH_KEY=
# If empty, password from tools/sa02m-device.env / cyntron is used by monitor
POSTFLASH_TIMEOUT_SEC=600
POSTFLASH_WEB_PORT=9999

# Subnet scan hint after reboot (comma-separated prefixes or leave empty to use DHCP leases)
# POSTFLASH_EXPECT_NET=192.168.1.0/24
