[Unit]
Description=MPLC4 / MasterSCADA 4D (обёртка над /etc/init.d/mplc4)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/init.d/mplc4 start
ExecStop=/etc/init.d/mplc4 stop
TimeoutStartSec=45s
TimeoutStartFailureMode=terminate
TimeoutStopSec=15
TimeoutStopFailureMode=terminate
KillMode=mixed

[Install]
WantedBy=multi-user.target
