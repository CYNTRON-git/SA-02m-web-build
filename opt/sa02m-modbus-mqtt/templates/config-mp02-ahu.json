{
  "_comment": "SA-02m device template for the MP-02 PLC running the air handling unit program (AHU). Self-authored from the MP-02 register map (docs/MODBUS_MAP.md, Net/mb_map.h, Plc/apps/ahu/ahu_prog.c) - not a Wiren Board file. Addresses are raw protocol addresses (0-based). Floats are IEEE-754, high word first. Operator window 190..193 and coil 16 need MP-02 firmware from 2026-09-27 or newer.",
  "device": {
    "name": "MP-02 AHU",
    "device_type": "cyntron-mp02-ahu",
    "channels": [
      {"name": "outdoor_temp",  "reg_type": "input", "address": 4000, "type": "temperature", "format": "float", "word_order": "big_endian", "units": "°C"},
      {"name": "supply_temp",   "reg_type": "input", "address": 4002, "type": "temperature", "format": "float", "word_order": "big_endian", "units": "°C"},
      {"name": "return_temp",   "reg_type": "input", "address": 4004, "type": "temperature", "format": "float", "word_order": "big_endian", "units": "°C"},
      {"name": "room_temp",     "reg_type": "input", "address": 4006, "type": "temperature", "format": "float", "word_order": "big_endian", "units": "°C"},
      {"name": "water_return_temp", "reg_type": "input", "address": 4008, "type": "temperature", "format": "float", "word_order": "big_endian", "units": "°C"},
      {"name": "room_humidity", "reg_type": "input", "address": 4014, "type": "rel_humidity", "format": "float", "word_order": "big_endian", "units": "%"},
      {"name": "effective_setpoint", "reg_type": "input", "address": 4028, "type": "temperature", "format": "float", "word_order": "big_endian", "units": "°C"},
      {"name": "heater_valve",  "reg_type": "input", "address": 4046, "type": "value", "format": "float", "word_order": "big_endian", "units": "%"},
      {"name": "supply_fan_speed", "reg_type": "input", "address": 4058, "type": "value", "format": "float", "word_order": "big_endian", "units": "%"},
      {"name": "exhaust_fan_speed", "reg_type": "input", "address": 4062, "type": "value", "format": "float", "word_order": "big_endian", "units": "%"},
      {"name": "sequencer_state", "reg_type": "input", "address": 4157, "type": "value", "format": "u16"},
      {"name": "winter_mode",   "reg_type": "input", "address": 4159, "type": "switch", "format": "u16"},
      {"name": "status_code",   "reg_type": "input", "address": 4200, "type": "value", "format": "u16"},
      {"name": "alarm_count",   "reg_type": "input", "address": 4207, "type": "value", "format": "u16"},
      {"name": "alarm_worst_class", "reg_type": "input", "address": 4208, "type": "value", "format": "u16"},
      {"name": "alarm_code",    "reg_type": "input", "address": 4210, "type": "value", "format": "u16"},

      {"name": "run",           "reg_type": "coil",    "address": 16,   "type": "switch", "readonly": false},
      {"name": "mode",          "reg_type": "holding", "address": 100, "type": "value", "format": "u16", "readonly": false},
      {"name": "temp_setpoint", "reg_type": "holding", "address": 190, "type": "value", "format": "s16", "scale": 0.1, "units": "°C", "readonly": false},
      {"name": "humidity_setpoint", "reg_type": "holding", "address": 191, "type": "value", "format": "s16", "scale": 0.1, "units": "%", "readonly": false},
      {"name": "fan_speed_manual", "reg_type": "holding", "address": 192, "type": "value", "format": "s16", "scale": 0.1, "units": "%", "readonly": false},
      {"name": "alarm_ack",     "reg_type": "coil",    "address": 2,   "type": "pushbutton", "readonly": false},
      {"name": "alarm_reset",   "reg_type": "coil",    "address": 3,   "type": "pushbutton", "readonly": false}
    ]
  }
}
