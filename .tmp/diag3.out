===WATCHDOG-FEED-UNIT===
[Unit]
Description=SA-02m hardware watchdog feeder
After=network.target
DefaultDependencies=no

[Service]
Type=simple
ExecStart=/bin/bash -c 'while true; do printf 1 > /dev/watchdog 2>/dev/null || true; sleep 10; done'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

