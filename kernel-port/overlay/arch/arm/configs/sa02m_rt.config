# SPDX-License-Identifier: GPL-2.0
#
# Merge-fragment для kernel/scripts/kconfig/merge_config.sh:
#   ./scripts/kconfig/merge_config.sh \
#       arch/arm/configs/sa02m_defconfig \
#       arch/arm/configs/sa02m_rt.config
#
# Применять после того, как rt-patches для kernel 5.10.35 наложены (см.
# tools/kernel-wb/build-sa02m-kernel.sh).
#
# Вариант: RT flavour SA-02м. LOCALVERSION становится "-sa02m-rt" — на
# устройстве такой kernel окажется в /lib/modules/5.10.35-sa02m-rt/.

CONFIG_LOCALVERSION="-sa02m-rt"

# PREEMPT_RT (kernel 5.10-rt requires PREEMPT_RT after patch)
# CONFIG_PREEMPT is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT_RT=y

# Расширенный tracing — нужен для отладки latency
CONFIG_LATENCYTOP=y
CONFIG_HIST_TRIGGERS=y

# RCU tunings — рекомендуется для RT
# CONFIG_TREE_RCU_TRACE is not set

# У RT-ядра выключается FTRACE_STARTUP_TEST (уже так в WB defconfig).
