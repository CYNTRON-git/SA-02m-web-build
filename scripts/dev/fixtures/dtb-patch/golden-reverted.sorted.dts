		};

		serial@1c29c00 {
			clocks = <0x02 0x67>;
			compatible = "snps,dw-apb-uart\0allwinner,sun8i-uart";
			interrupts = <0x00 0x14 0x04>;
			pinctrl-0 = <0x26>;
			pinctrl-names = "default";
			reg = <0x1c29c00 0x400>;
			reg-io-width = <0x04>;
			reg-shift = <0x02>;
			resets = <0x02 0x50>;
			status = "okay";
		};

		spi@1c05000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "ahb\0mod";
			clocks = <0x02 0x29 0x02 0x71>;
			compatible = "allwinner,sun8i-r40-spi\0allwinner,sun8i-h3-spi";
			interrupts = <0x00 0x0a 0x04>;
			reg = <0x1c05000 0x1000>;
			resets = <0x02 0x11>;
			status = "disabled";
		};

		spi@1c06000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "ahb\0mod";
			clocks = <0x02 0x2a 0x02 0x72>;
			compatible = "allwinner,sun8i-r40-spi\0allwinner,sun8i-h3-spi";
			dma-names = "rx\0tx";
			dmas = <0x10 0x19 0x10 0x19>;
			interrupts = <0x00 0x0b 0x04>;
			reg = <0x1c06000 0x1000>;
			resets = <0x02 0x12>;
			status = "disabled";
		};

		spi@1c17000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "ahb\0mod";
			clocks = <0x02 0x2b 0x02 0x73>;
			compatible = "allwinner,sun8i-r40-spi\0allwinner,sun8i-h3-spi";
			interrupts = <0x00 0x0c 0x04>;
			reg = <0x1c17000 0x1000>;
			resets = <0x02 0x13>;
			status = "disabled";
		};

		spi@1c1f000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "ahb\0mod";
			clocks = <0x02 0x2c 0x02 0x74>;
			compatible = "allwinner,sun8i-r40-spi\0allwinner,sun8i-h3-spi";
			interrupts = <0x00 0x32 0x04>;
			reg = <0x1c1f000 0x1000>;
			resets = <0x02 0x14>;
			status = "disabled";
		};

		system-control@1c00000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "allwinner,sun8i-r40-system-control\0allwinner,sun4i-a10-system-control";
			ranges;
			reg = <0x1c00000 0x30>;

			sram@0 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "mmio-sram";
				ranges = <0x00 0x00 0xc000>;
				reg = <0x00 0xc000>;

				sram-section@8000 {
					compatible = "allwinner,sun4i-a10-sram-a3-a4";
					phandle = <0x32>;
					reg = <0x8000 0x4000>;
					status = "okay";
				};
			};

			sram@1d00000 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "mmio-sram";
				ranges = <0x00 0x1d00000 0xd0000>;
				reg = <0x1d00000 0xd0000>;

				sram-section@0 {
					compatible = "allwinner,sun8i-r40-sram-c1\0allwinner,sun4i-a10-sram-c1";
					phandle = <0x12>;
					reg = <0x00 0x80000>;
				};
			};
		};

		tcon-top@1c70000 {
			#clock-cells = <0x01>;
			clock-names = "bus\0tcon-tv0\0tve0\0tcon-tv1\0tve1\0dsi";
			clock-output-names = "tcon-top-tv0\0tcon-top-tv1\0tcon-top-dsi";
			clocks = <0x02 0x4b 0x02 0x90 0x02 0x9d 0x02 0x91 0x02 0x9e 0x02 0x9c>;
			compatible = "allwinner,sun8i-r40-tcon-top";
			phandle = <0x47>;
			reg = <0x1c70000 0x1000>;
			resets = <0x02 0x33>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						phandle = <0x0e>;
						remote-endpoint = <0x35>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;

					endpoint@0 {
						phandle = <0x42>;
						reg = <0x00>;
						remote-endpoint = <0x36>;
					};

					endpoint@1 {
						phandle = <0x45>;
						reg = <0x01>;
						remote-endpoint = <0x37>;
					};

					endpoint@2 {
						phandle = <0x48>;
						reg = <0x02>;
						remote-endpoint = <0x38>;
					};

					endpoint@3 {
						phandle = <0x4b>;
						reg = <0x03>;
						remote-endpoint = <0x39>;
					};
				};

				port@2 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x02>;

					endpoint@1 {
						phandle = <0x0f>;
						reg = <0x01>;
						remote-endpoint = <0x3a>;
					};
				};

				port@3 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x03>;

					endpoint@0 {
						phandle = <0x43>;
						reg = <0x00>;
						remote-endpoint = <0x3b>;
					};

					endpoint@1 {
						phandle = <0x46>;
						reg = <0x01>;
						remote-endpoint = <0x3c>;
					};

					endpoint@2 {
						phandle = <0x49>;
						reg = <0x02>;
						remote-endpoint = <0x3d>;
					};

					endpoint@3 {
						phandle = <0x4c>;
						reg = <0x03>;
						remote-endpoint = <0x3e>;
					};
				};

				port@4 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x04>;

					endpoint@0 {
						phandle = <0x4a>;
						reg = <0x00>;
						remote-endpoint = <0x3f>;
					};

					endpoint@1 {
						phandle = <0x4d>;
						reg = <0x01>;
						remote-endpoint = <0x40>;
					};
				};

				port@5 {
					reg = <0x05>;

					endpoint {
						phandle = <0x51>;
						remote-endpoint = <0x41>;
					};
				};
			};
		};

		thermal-sensor@1c24c00 {
			#thermal-sensor-cells = <0x01>;
			clock-names = "bus\0mod";
			clocks = <0x02 0x52 0x02 0x69>;
			compatible = "allwinner,sun8i-r40-ths";
			interrupts = <0x00 0x24 0x04>;
			nvmem-cell-names = "calibration";
			nvmem-cells = <0x21>;
			phandle = <0x07>;
			reg = <0x1c24c00 0x100>;
			resets = <0x02 0x3b>;
		};

		timer@1c20c00 {
			clocks = <0x1a>;
			compatible = "allwinner,sun4i-a10-timer";
			interrupts = <0x00 0x16 0x04 0x00 0x17 0x04 0x00 0x18 0x04 0x00 0x19 0x04 0x00 0x43 0x04 0x00 0x44 0x04>;
			reg = <0x1c20c00 0x90>;
		};

		tvd@1c30000 {
			clock-names = "clk_bus_tvd_top\0clk_dram_tvd\0clk_bus_tvd0\0clk_tvd0\0clk_bus_tvd1\0clk_tvd1\0clk_bus_tvd2\0clk_tvd2\0clk_bus_tvd3\0clk_tvd3";
			clocks = <0x02 0x46 0x02 0x89 0x02 0x42 0x02 0x9f 0x02 0x43 0x02 0xa0 0x02 0x44 0x02 0xa1 0x02 0x45 0x02 0xa2>;
			compatible = "allwinner,sun8i-tvd";
			interrupt-names = "irq_tvd0\0irq_tvd1\0irq_tvd2\0irq_tvd3";
			interrupts = <0x00 0x61 0x04 0x00 0x62 0x04 0x00 0x63 0x04 0x00 0x64 0x04>;
			reg = <0x1c30000 0x1000 0x1c31000 0x1000 0x1c32000 0x1000 0x1c33000 0x1000 0x1c34000 0x1000>;
			reg-names = "regs_top\0regs_tvd0\0regs_tvd1\0regs_tvd2\0regs_tvd3";
			reset-names = "rst_bus_tvd_top\0rst_bus_tvd0\0rst_bus_tvd1\0rst_bus_tvd2\0rst_bus_tvd3";
			resets = <0x02 0x2e 0x02 0x2a 0x02 0x2b 0x02 0x2c 0x02 0x2d>;
			status = "okay";
			tvd-supply = <0x2e>;
		};

		usb@1c13000 {
			clocks = <0x02 0x2e>;
			compatible = "allwinner,sun8i-h3-musb";
			dr_mode = "peripheral";
			extcon = <0x18 0x00>;
			interrupt-names = "mc";
			interrupts = <0x00 0x26 0x04>;
			phy-names = "usb";
			phys = <0x18 0x00>;
			reg = <0x1c13000 0x400>;
			resets = <0x02 0x16>;
			status = "okay";
		};

		usb@1c14000 {
			clocks = <0x02 0x2f 0x02 0x32>;
			compatible = "allwinner,sun8i-r40-ehci\0generic-ehci";
			interrupts = <0x00 0x27 0x04>;
			reg = <0x1c14000 0x100>;
			resets = <0x02 0x17 0x02 0x1a>;
			status = "disabled";
		};

		usb@1c14400 {
			clocks = <0x02 0x2f 0x02 0x32 0x02 0x7f>;
			compatible = "allwinner,sun8i-r40-ohci\0generic-ohci";
			interrupts = <0x00 0x28 0x04>;
			reg = <0x1c14400 0x100>;
			resets = <0x02 0x17 0x02 0x1a>;
			status = "disabled";
		};

		usb@1c19000 {
			clocks = <0x02 0x30>;
			compatible = "allwinner,sun8i-r40-ehci\0generic-ehci";
			interrupts = <0x00 0x4c 0x04>;
			phy-names = "usb";
			phys = <0x18 0x01>;
			reg = <0x1c19000 0x100>;
			resets = <0x02 0x18>;
			status = "okay";
		};

		usb@1c19400 {
			clocks = <0x02 0x33 0x02 0x80>;
			compatible = "allwinner,sun8i-r40-ohci\0generic-ohci";
			interrupts = <0x00 0x40 0x04>;
			phy-names = "usb";
			phys = <0x18 0x01>;
			reg = <0x1c19400 0x100>;
			resets = <0x02 0x1b>;
			status = "okay";
		};

		usb@1c1c000 {
			clocks = <0x02 0x31>;
			compatible = "allwinner,sun8i-r40-ehci\0generic-ehci";
			interrupts = <0x00 0x4e 0x04>;
			phy-names = "usb";
			phys = <0x18 0x02>;
			reg = <0x1c1c000 0x100>;
			resets = <0x02 0x19>;
			status = "okay";
		};

		usb@1c1c400 {
			clocks = <0x02 0x34 0x02 0x81>;
			compatible = "allwinner,sun8i-r40-ohci\0generic-ohci";
			interrupts = <0x00 0x41 0x04>;
			phy-names = "usb";
			phys = <0x18 0x02>;
			reg = <0x1c1c400 0x100>;
			resets = <0x02 0x1c>;
			status = "okay";
		};

		video-codec@1c0e000 {
			allwinner,sram = <0x12 0x01>;
			clock-names = "ahb\0mod\0ram";
			clocks = <0x02 0x35 0x02 0x96 0x02 0x85>;
			compatible = "allwinner,sun8i-r40-video-engine";
			interrupts = <0x00 0x35 0x04>;
			reg = <0x1c0e000 0x1000>;
			resets = <0x02 0x1d>;
		};

		watchdog@1c20c90 {
			clocks = <0x1a>;
			compatible = "allwinner,sun4i-a10-wdt";
			interrupts = <0x00 0x18 0x04>;
			reg = <0x1c20c90 0x10>;
		};
	};

	thermal-zones {

		cpu0-thermal {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			thermal-sensors = <0x07 0x00>;

			cooling-maps {

				cpu-hot-limit {
					cooling-device = <0x09 0xffffffff 0xffffffff 0x0a 0xffffffff 0xffffffff 0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff>;
					trip = <0x08>;
				};
			};

			trips {

				cpu-hot {
					hysteresis = <0x7d0>;
					phandle = <0x08>;
					temperature = <0x13880>;
					type = "passive";
				};

				cpu-very-hot {
					hysteresis = <0x00>;
					temperature = <0x1c138>;
					type = "critical";
				};
			};
		};

		gpu-thermal {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			thermal-sensors = <0x07 0x01>;

			trips {

				gpu-hot {
					hysteresis = <0x7d0>;
					temperature = <0x15f90>;
					type = "passive";
				};

				gpu-very-hot {
					hysteresis = <0x00>;
					temperature = <0x1e848>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};
};
