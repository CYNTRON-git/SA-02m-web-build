			interrupts = <0x00 0x11 0x04>;
			pinctrl-0 = <0x24>;
			pinctrl-names = "default";
			reg = <0x1c29000 0x400>;
			reg-io-width = <0x04>;
			reg-shift = <0x02>;
			resets = <0x02 0x4d>;
			status = "okay";
		};

		serial@1c29400 {
			clocks = <0x02 0x65>;
			compatible = "snps,dw-apb-uart\0allwinner,sun8i-uart";
			interrupts = <0x00 0x12 0x04>;
			pinctrl-0 = <0x25>;
			pinctrl-names = "default";
			reg = <0x1c29400 0x400>;
			reg-io-width = <0x04>;
			reg-shift = <0x02>;
			resets = <0x02 0x4e>;
			status = "okay";
		};

		serial@1c29800 {
			clocks = <0x02 0x66>;
			compatible = "snps,dw-apb-uart\0allwinner,sun8i-uart";
			interrupts = <0x00 0x13 0x04>;
			reg = <0x1c29800 0x400>;
