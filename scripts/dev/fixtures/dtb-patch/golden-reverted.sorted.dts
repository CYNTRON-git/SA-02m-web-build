/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	compatible = "sk,a40i-nano-2e\0allwinner,sun8i-r40";
	interrupt-parent = <0x01>;
	model = "Cyntron A40i-2Eth";

	aliases {
		ethernet0 = "/soc/ethernet@1c0b000";
		ethernet1 = "/soc/ethernet@1c50000";
		mmc0 = "/soc/mmc@1c0f000";
		mmc1 = "/soc/mmc@1c10000";
		mmc2 = "/soc/mmc@1c11000";
		mmc3 = "/soc/mmc@1c12000";
		serial0 = "/soc/serial@1c28000";
		serial1 = "/soc/serial@1c28400";
		serial2 = "/soc/serial@1c28800";
		serial3 = "/soc/serial@1c28c00";
		serial4 = "/soc/serial@1c29000";
		serial5 = "/soc/serial@1c29400";
		serial6 = "/soc/serial@1c29800";
		serial7 = "/soc/serial@1c29c00";
	};

	clocks {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		osc24M {
			#clock-cells = <0x00>;
			clock-accuracy = <0xc350>;
			clock-frequency = <0x16e3600>;
			clock-output-names = "osc24M";
			compatible = "fixed-clock";
			phandle = <0x1a>;
		};

		osc32k {
			#clock-cells = <0x00>;
			clock-accuracy = <0x4e20>;
			clock-frequency = <0x8000>;
			clock-output-names = "ext-osc32k";
			compatible = "fixed-clock";
			phandle = <0x1c>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			#cooling-cells = <0x02>;
			clock-names = "cpu";
			clocks = <0x02 0x18>;
			compatible = "arm,cortex-a7";
			cpu-supply = <0x04>;
			device_type = "cpu";
			operating-points-v2 = <0x03>;
			phandle = <0x09>;
			reg = <0x00>;
		};

		cpu@1 {
			#cooling-cells = <0x02>;
			clock-names = "cpu";
			clocks = <0x02 0x18>;
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			operating-points-v2 = <0x03>;
			phandle = <0x0a>;
			reg = <0x01>;
		};

		cpu@2 {
			#cooling-cells = <0x02>;
			clock-names = "cpu";
			clocks = <0x02 0x18>;
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			operating-points-v2 = <0x03>;
			phandle = <0x0b>;
			reg = <0x02>;
		};

		cpu@3 {
			#cooling-cells = <0x02>;
			clock-names = "cpu";
			clocks = <0x02 0x18>;
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			operating-points-v2 = <0x03>;
			phandle = <0x0c>;
			reg = <0x03>;
		};
	};

	display-engine {
		allwinner,pipelines = <0x05 0x06>;
		compatible = "allwinner,sun8i-r40-display-engine";
		status = "disabled";
	};

	iio-hwmon-axp {
		compatible = "iio-hwmon";
		io-channels = <0x52 0x00 0x52 0x01 0x52 0x02>;
	};

	iio-hwmon-axp-temp {
		compatible = "iio-hwmon";
		io-channels = <0x52 0x00>;
	};

	leds {
		compatible = "gpio-leds";

		eth0_link {
			default-state = "off";
			gpios = <0x31 0x01 0x02 0x01>;
			linux,default-trigger = "1c0b080.mdio-mii:00:link";
		};

		eth1_link {
			default-state = "off";
			gpios = <0x31 0x08 0x0d 0x01>;
			linux,default-trigger = "stmmac-1:00:link";
		};
	};

	opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x03>;

		opp-1008000000 {
			clock-latency-ns = <0x1e8480>;
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt = <0x11b340 0x11b340 0x13d620>;
		};

		opp-1104000000 {
			clock-latency-ns = <0x1e8480>;
			opp-hz = <0x00 0x41cdb400>;
			opp-microvolt = <0x12ebc0 0x12ebc0 0x13d620>;
		};

		opp-1200000000 {
			clock-latency-ns = <0x1e8480>;
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0x13d620 0x13d620 0x13d620>;
		};

		opp-720000000 {
			clock-latency-ns = <0x1e8480>;
			opp-hz = <0x00 0x2aea5400>;
			opp-microvolt = <0xf4240 0xf4240 0x13d620>;
		};

		opp-912000000 {
			clock-latency-ns = <0x1e8480>;
			opp-hz = <0x00 0x365c0400>;
			opp-microvolt = <0x10c8e0 0x10c8e0 0x13d620>;
		};
	};

	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupt-affinity = <0x09 0x0a 0x0b 0x0c>;
		interrupts = <0x00 0x78 0x04 0x00 0x79 0x04 0x00 0x7a 0x04 0x00 0x7b 0x04>;
	};

	regulators {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "simple-bus";

		regulator@0 {
			compatible = "regulator-fixed";
			regulator-always-on;
			regulator-max-microvolt = <0x325aa0>;
			regulator-min-microvolt = <0x325aa0>;
			regulator-name = "3P3V";
		};

		regulator@1 {
			compatible = "regulator-fixed";
			phandle = <0x19>;
			reg = <0x01>;
			regulator-max-microvolt = <0x4c4b40>;
			regulator-min-microvolt = <0x4c4b40>;
			regulator-name = "usb0_vbus";
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges;

		can@1c2bc00 {
			clocks = <0x02 0x5b>;
			compatible = "allwinner,sun8i-r40-can";
			interrupts = <0x00 0x1a 0x04>;
			pinctrl-0 = <0x2c>;
			pinctrl-names = "default";
			reg = <0x1c2bc00 0x400>;
			resets = <0x02 0x44>;
			status = "okay";
		};

		clock@1000000 {
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			clock-names = "bus\0mod";
			clocks = <0x02 0x3c 0x02 0x8c>;
			compatible = "allwinner,sun8i-r40-de2-clk\0allwinner,sun8i-h3-de2-clk";
			phandle = <0x0d>;
			reg = <0x1000000 0x10000>;
			resets = <0x02 0x24>;
		};

		clock@1c20000 {
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			clock-names = "hosc\0losc";
			clocks = <0x1a 0x1b 0x00>;
			compatible = "allwinner,sun8i-r40-ccu";
			phandle = <0x02>;
			reg = <0x1c20000 0x400>;
		};

		codec-analog@1c22f00 {
			compatible = "allwinner,sun8i-r40-codec-analog";
			phandle = <0x20>;
			reg = <0x1c22f00 0x04>;
		};

		codec@1c22c00 {
			#sound-dai-cells = <0x00>;
			allwinner,audio-routing = "Headphone\0HP\0LINEIN\0Line In";
			allwinner,codec-analog-controls = <0x20>;
			clock-names = "apb\0codec";
			clocks = <0x02 0x4c 0x02 0x97>;
			compatible = "allwinner,sun8i-h3-codec";
			dma-names = "rx\0tx";
			dmas = <0x10 0x13 0x10 0x13>;
			interrupts = <0x00 0x1e 0x04>;
			reg = <0x1c22c00 0x300>;
			resets = <0x02 0x36>;
			status = "okay";
		};

		crypto@1c15000 {
			clock-names = "bus\0mod";
			clocks = <0x02 0x1e 0x02 0x70>;
			compatible = "allwinner,sun8i-r40-crypto";
			interrupts = <0x00 0x5e 0x04>;
			reg = <0x1c15000 0x1000>;
			resets = <0x02 0x06>;
		};

		csi@1c09000 {
			clock-names = "bus\0isp\0ram";
			clocks = <0x02 0x38 0x02 0x94 0x02 0x86>;
			compatible = "allwinner,sun8i-r40-csi0\0allwinner,sun7i-a20-csi0";
			interconnect-names = "dma-mem";
			interconnects = <0x11 0x05>;
			interrupts = <0x00 0x2a 0x04>;
			reg = <0x1c09000 0x1000>;
			resets = <0x02 0x20>;
			status = "disabled";
		};

		d-phy@1ca1000 {
			#phy-cells = <0x00>;
			clock-names = "bus\0mod";
			clocks = <0x02 0x1d 0x02 0x9c>;
			compatible = "allwinner,sun8i-r40-mipi-dphy\0allwinner,sun6i-a31-mipi-dphy";
			phandle = <0x4e>;
			reg = <0x1ca1000 0x1000>;
			resets = <0x02 0x05>;
			status = "disabled";
		};

		deinterlace@1400000 {
			clock-names = "bus\0mod\0ram";
			clocks = <0x02 0x37 0x02 0x92 0x02 0x87>;
			compatible = "allwinner,sun8i-r40-deinterlace\0allwinner,sun8i-h3-deinterlace";
			interrupts = <0x00 0x5d 0x04>;
			reg = <0x1400000 0x20000>;
			resets = <0x02 0x1f>;
		};

		dma-controller@1c02000 {
			#dma-cells = <0x01>;
			clocks = <0x02 0x1f>;
			compatible = "allwinner,sun8i-r40-dma\0allwinner,sun50i-a64-dma";
			dma-channels = <0x10>;
			dma-requests = <0x1f>;
			interrupts = <0x00 0x1b 0x04>;
			phandle = <0x10>;
			reg = <0x1c02000 0x1000>;
			resets = <0x02 0x07>;
		};

		dram-controller@1c62000 {
			#address-cells = <0x01>;
			#interconnect-cells = <0x01>;
			#size-cells = <0x01>;
			clocks = <0x02 0x9b>;
			compatible = "allwinner,sun8i-r40-mbus";
			dma-ranges = <0x00 0x40000000 0x80000000>;
			phandle = <0x11>;
			reg = <0x1c62000 0x1000>;
		};

		dsi@1ca0000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "bus\0mod";
			clocks = <0x02 0x1d 0x47 0x02>;
			compatible = "allwinner,sun8i-r40-mipi-dsi\0allwinner,sun6i-a31-mipi-dsi";
			interrupts = <0x00 0x39 0x04>;
			phy-names = "dphy";
			phys = <0x4e>;
			reg = <0x1ca0000 0x1000>;
			resets = <0x02 0x05>;
			status = "disabled";

			port {

				endpoint {
					phandle = <0x44>;
					remote-endpoint = <0x4f>;
				};
			};
		};

		eeprom@1c1b000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "allwinner,sun8i-r40-sid";
			reg = <0x1c1b000 0x200>;

			thermal-sensor-calibration@40 {
				phandle = <0x21>;
				reg = <0x40 0x04>;
			};
		};

		ethernet@1c0b000 {
			allwinner,sram = <0x32 0x01>;
			clocks = <0x02 0x26>;
			compatible = "allwinner,sun8i-r40-emac";
			interrupts = <0x00 0x37 0x04>;
			phy-handle = <0x34>;
			phy-mode = "mii";
			phy-supply = <0x15>;
			pinctrl-0 = <0x33>;
			pinctrl-names = "default";
			reg = <0x1c0b000 0x1000>;
			resets = <0x02 0x0e>;
			status = "okay";
		};

		ethernet@1c50000 {
			clock-names = "stmmaceth";
			clocks = <0x02 0x40>;
			compatible = "allwinner,sun8i-r40-gmac";
			interrupt-names = "macirq";
			interrupts = <0x00 0x55 0x04>;
			phy-handle = <0x30>;
			phy-mode = "mii";
			phy-supply = <0x15>;
			pinctrl-0 = <0x2f>;
			pinctrl-names = "default";
			reg = <0x1c50000 0x10000>;
			reset-names = "stmmaceth";
			resets = <0x02 0x28>;
			status = "okay";
			syscon = <0x02>;

			mdio {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "snps,dwmac-mdio";
				status = "okay";

				ethernet-phy@0 {
					compatible = "icplus,ip101a\0ethernet-phy-ieee802.3-c22";
					icplus,select-rx-error;
					phandle = <0x30>;
					reg = <0x00>;
					reset-assert-us = <0x2710>;
					reset-deassert-us = <0x7a120>;
					reset-gpios = <0x31 0x07 0x0d 0x01>;
					status = "okay";
				};
			};
		};

		gpu@1c40000 {
			clock-names = "bus\0core";
			clocks = <0x02 0x41 0x02 0xa3>;
			compatible = "allwinner,sun8i-r40-mali\0arm,mali-400";
			interrupt-names = "gp\0gpmmu\0pp0\0ppmmu0\0pp1\0ppmmu1\0pmu";
			interrupts = <0x00 0x45 0x04 0x00 0x46 0x04 0x00 0x47 0x04 0x00 0x48 0x04 0x00 0x4a 0x04 0x00 0x4b 0x04 0x00 0x49 0x04>;
			reg = <0x1c40000 0x10000>;
			resets = <0x02 0x29>;
		};

		hdmi-phy@1ef0000 {
			#phy-cells = <0x00>;
			clock-names = "bus\0mod\0pll-0\0pll-1";
			clocks = <0x02 0x3a 0x02 0x9a 0x02 0x07 0x02 0x10>;
			compatible = "allwinner,sun8i-r40-hdmi-phy";
			phandle = <0x50>;
			reg = <0x1ef0000 0x10000>;
			reset-names = "phy";
			resets = <0x02 0x22>;
			tvd-supply = <0x2e>;
		};

		hdmi@1ee0000 {
			clock-names = "iahb\0isfr\0tmds\0cec";
			clocks = <0x02 0x3b 0x02 0x9a 0x02 0x99 0x1b 0x00>;
			compatible = "allwinner,sun8i-r40-dw-hdmi\0allwinner,sun8i-a83t-dw-hdmi";
			interrupts = <0x00 0x3a 0x04>;
			phy-names = "phy";
			phys = <0x50>;
			reg = <0x1ee0000 0x10000>;
			reg-io-width = <0x01>;
			reset-names = "ctrl";
			resets = <0x02 0x23>;
			status = "disabled";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						phandle = <0x41>;
						remote-endpoint = <0x51>;
					};
				};

				port@1 {
					reg = <0x01>;
				};
			};
		};

		i2c@1c2ac00 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x02 0x57>;
			compatible = "allwinner,sun6i-a31-i2c";
			interrupts = <0x00 0x07 0x04>;
			pinctrl-0 = <0x27>;
			pinctrl-names = "default";
			reg = <0x1c2ac00 0x400>;
			resets = <0x02 0x40>;
			status = "okay";

			pmic@34 {
				#interrupt-cells = <0x01>;
				compatible = "x-powers,axp221";
				interrupt-controller;
				interrupt-parent = <0x28>;
				interrupts = <0x00 0x08>;
				reg = <0x34>;

				ac-power {
					compatible = "x-powers,axp221-ac-power-supply";
					status = "disabled";
				};

				adc {
					#io-channel-cells = <0x01>;
					compatible = "x-powers,axp221-adc";
					phandle = <0x52>;
				};

				battery-power {
					compatible = "x-powers,axp221-battery-power-supply";
					status = "disabled";
				};

				regulators {
					x-powers,dcdc-freq = <0xbb8>;

					aldo1 {
						phandle = <0x2e>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-min-microvolt = <0x325aa0>;
						regulator-name = "tvd";
					};

					aldo2 {
						phandle = <0x16>;
						regulator-always-on;
						regulator-max-microvolt = <0x1b7740>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-name = "aldo2";
					};

					aldo3 {
						regulator-always-on;
						regulator-init-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x2dc6c0>;
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-name = "avcc-pll";
					};

					dc1sw {
						regulator-always-on;
						regulator-max-microvolt = <0x325aa0>;
						regulator-min-microvolt = <0x325aa0>;
						regulator-name = "vcc-gmac-phy";
					};

					dc5ldo {
						regulator-name = "dc5ldo";
					};

					dcdc1 {
						phandle = <0x15>;
						regulator-always-on;
						regulator-max-microvolt = <0x325aa0>;
						regulator-min-microvolt = <0x325aa0>;
						regulator-name = "vcc-3v3";
					};

					dcdc2 {
						phandle = <0x04>;
						regulator-always-on;
						regulator-max-microvolt = <0x13d620>;
						regulator-min-microvolt = <0xf4240>;
						regulator-name = "vdd-cpu";
					};

					dcdc3 {
						regulator-always-on;
						regulator-max-microvolt = <0x13d620>;
						regulator-min-microvolt = <0xf4240>;
						regulator-name = "vdd-sys";
					};

					dcdc4 {
						regulator-name = "dcdc4";
					};

					dcdc5 {
						regulator-always-on;
						regulator-max-microvolt = <0x149970>;
						regulator-min-microvolt = <0x149970>;
						regulator-name = "vcc-dram";
					};

					dldo1 {
						regulator-always-on;
						regulator-max-microvolt = <0x1b7740>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-name = "vcc-sd-alt";
					};

					dldo2 {
						regulator-name = "dldo2";
					};

					dldo3 {
						regulator-name = "dldo3";
					};

					dldo4 {
						regulator-name = "dldo4";
					};

					drivevbus {
						regulator-name = "drivevbus";
						status = "disabled";
					};

					eldo1 {
						regulator-name = "eldo1";
					};

					eldo2 {
						regulator-name = "eldo2";
					};

					eldo3 {
						phandle = <0x1d>;
						regulator-always-on;
						regulator-init-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-name = "vcc-pe";
					};

					ldo_io0 {
						regulator-max-microvolt = <0x2625a0>;
						regulator-min-microvolt = <0x2625a0>;
						regulator-name = "vdd2v5-sata";
						status = "okay";
					};

					ldo_io1 {
						regulator-name = "ldo_io1";
						status = "disabled";
					};

					rtc_ldo {
						regulator-always-on;
						regulator-max-microvolt = <0x2dc6c0>;
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-name = "rtc_ldo";
					};
				};

				usb-power {
					compatible = "x-powers,axp221-usb-power-supply";
					status = "disabled";
				};
			};
		};

		i2c@1c2b000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x02 0x58>;
			compatible = "allwinner,sun6i-a31-i2c";
			interrupts = <0x00 0x08 0x04>;
			pinctrl-0 = <0x29>;
			pinctrl-names = "default";
			reg = <0x1c2b000 0x400>;
			resets = <0x02 0x41>;
			status = "okay";
		};

		i2c@1c2b400 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x02 0x59>;
			compatible = "allwinner,sun6i-a31-i2c";
			interrupts = <0x00 0x09 0x04>;
			pinctrl-0 = <0x2a>;
			pinctrl-names = "default";
			reg = <0x1c2b400 0x400>;
			resets = <0x02 0x42>;
			status = "disabled";
		};

		i2c@1c2b800 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x02 0x5a>;
			compatible = "allwinner,sun6i-a31-i2c";
			interrupts = <0x00 0x58 0x04>;
			pinctrl-0 = <0x2b>;
			pinctrl-names = "default";
			reg = <0x1c2b800 0x400>;
			resets = <0x02 0x43>;
			status = "okay";
		};

		i2c@1c2c000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
