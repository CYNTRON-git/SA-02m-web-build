/dts-v1/;

/* SA-02m fixture: bench 1.135 decompile (dtc 1.7.0) of the ORIGINAL boot blob,
 * trimmed to the nodes the patcher touches; every kept node is a byte-exact
 * copy. dtc 1.7 writes a string list as ONE literal with \0 escapes.
 * d0.dts (a bench copy, not in the tree): before any apply. */

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;
	model = "Cyntron A40i-2Eth";
	compatible = "sk,a40i-nano-2e\0allwinner,sun8i-r40";

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		i2c@1c2ac00 {
			compatible = "allwinner,sun6i-a31-i2c";
			reg = <0x1c2ac00 0x400>;
			interrupts = <0x00 0x07 0x04>;
			clocks = <0x02 0x57>;
			resets = <0x02 0x40>;
			pinctrl-0 = <0x27>;
			pinctrl-names = "default";
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			pmic@34 {
				compatible = "x-powers,axp221";
				reg = <0x34>;
				interrupt-parent = <0x28>;
				interrupts = <0x00 0x08>;
				interrupt-controller;
				#interrupt-cells = <0x01>;

				regulators {
					x-powers,dcdc-freq = <0xbb8>;

					dc1sw {
						regulator-always-on;
						regulator-name = "vcc-gmac-phy";
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
					};
				};
			};
		};

		i2c@1c2b800 {
			compatible = "allwinner,sun6i-a31-i2c";
			reg = <0x1c2b800 0x400>;
			interrupts = <0x00 0x58 0x04>;
			clocks = <0x02 0x5a>;
			resets = <0x02 0x43>;
			pinctrl-0 = <0x2b>;
			pinctrl-names = "default";
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
		};

		ethernet@1c50000 {
			compatible = "allwinner,sun8i-r40-gmac";
			syscon = <0x02>;
			reg = <0x1c50000 0x10000>;
			interrupts = <0x00 0x55 0x04>;
			interrupt-names = "macirq";
			resets = <0x02 0x28>;
			reset-names = "stmmaceth";
			clocks = <0x02 0x40>;
			clock-names = "stmmaceth";
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x2f>;
			phy-handle = <0x30>;
			phy-mode = "mii";
			phy-supply = <0x15>;

			mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				ethernet-phy@0 {
					compatible = "icplus,ip101a\0ethernet-phy-ieee802.3-c22";
					reg = <0x00>;
					reset-gpios = <0x31 0x07 0x0d 0x01>;
					reset-assert-us = <0x2710>;
					reset-deassert-us = <0x7a120>;
					icplus,select-rx-error;
					status = "okay";
					phandle = <0x30>;
				};
			};
		};

		ethernet@1c0b000 {
			compatible = "allwinner,sun8i-r40-emac";
			reg = <0x1c0b000 0x1000>;
			interrupts = <0x00 0x37 0x04>;
			clocks = <0x02 0x26>;
			resets = <0x02 0x0e>;
			allwinner,sram = <0x32 0x01>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x33>;
			phy-handle = <0x34>;
			phy-mode = "mii";
			phy-supply = <0x15>;
		};

		mdio@1c0b080 {
			compatible = "allwinner,sun4i-a10-mdio";
			reg = <0x1c0b080 0x14>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			ethernet-phy@0 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <0x00>;
				reset-gpios = <0x31 0x07 0x0c 0x01>;
				reset-assert-us = <0x2710>;
				reset-deassert-us = <0x7a120>;
				icplus,select-rx-error;
				status = "okay";
				phandle = <0x34>;
			};
		};
	};
};
