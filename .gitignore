# Boost и сторонние библиотеки (тысячи файлов, не нужны в репо)
API/

# Временные файлы
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Сайт и выгрузка прошивок: манифест и приватные заметки не в репо (скрипты pack/upload — в репо)
firmware-site-export/index.json
firmware-site-export/site-deploy.config.json
firmware-site-export/*.md
!firmware-site-export/*.example.md
# Локальные правки скрипта подготовки под сайт (если появятся)
opt/sa02m-flasher/scripts/prepare_firmware_for_site.local.py

# Локальные приватные файлы (не в репо)
private/

# Локальный клон для сверки с драйвером PCA9536 (не в репо)
.tmp-pca9536-sdk/

# Артефакты снятия образа eMMC (make-image.sh)
tools/imaging/out/
tools/imaging/flash-media/
# Temporary working directory
.tmp/
tmp/

# Vendor payload (CODESYS Runtime .deb, MPLC install tarballs, лицензионные .wbc/.lic).
# Проприетарные бинарники не коммитим — они лежат локально на build-host в vendor/
# и копируются в /opt/vendor-installers/ через tools/debian-rootfs/create-sa02m-rootfs.sh.
# См. docs/vendor-integrations.md.
/vendor/
*.wbc
*.lic
*.WibuCmLif
*.wbb

# ai-dev protocol — volatile session state (never committed; .ai-dev/ framework itself IS committed)
.ai-dev/state/
.ai-dev/plans/
.ai-dev/reviews/
.ai-dev/audit/
.ai-dev/feedback/
.ai-dev/worktrees/
.ai-dev/UPGRADING.md
.ai-dev/config.local.json
.ai-dev/model-routes.local.json
cookies.txt

# Dev-only UI-layout driver — per-run full-page screenshots (просмотр вёрстки),
# never committed. The driver lives in .ai-dev/quality/checks/ui-layout.mjs.
.ai-dev/quality/screenshots/

# Node dev-tooling deps at the repo root (the UI-layout driver reuses scripts/dev's
# playwright; a root `npm install` would still create an empty node_modules).
/node_modules/

# Lab/factory device credentials (plaintext) — single home for scripts, never
# committed. Documented in docs/AGENTS_SSH_AND_DEVICE_ACCESS.md.
tools/sa02m-device.env
