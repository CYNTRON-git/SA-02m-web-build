# SA-02m: ротация логов MPLC4 (vendor MasterSCADA MPLC 4D Runtime).
# Ставится scripts/01-system.sh, там же — страховка от двойной ротации.
#
# Имя sa02m-mplc4, а не mplc4: vendor-пакет вправе владеть
# /etc/logrotate.d/mplc4, и одноимённый файл был бы молча затёрт при следующей
# установке вендора (или затёр бы его).
#
# copytruncate, а не create: пишут вендорские бинарники (рантайм MPLC4 и его
# собственный nginx), послать им сигнал на переоткрытие файла мы не можем.
# Это же решение уже принято в etc/logrotate.d/sa02m-flasher. Цена —
# ограниченная гонка записи: несколько строк на момент ротации могут потеряться.
# Держат ли эти процессы fd открытым, на плате не проверялось — copytruncate
# выбран как безопасная ветка, а не как доказанно необходимая.
#
# Каталог 755 root:root (etc/sa02m-check-service-perms.sh), поэтому строка `su`
# не нужна — в отличие от flasher'а с его сервисным пользователем.
#
# /var/log/mplc4/dumps НАМЕРЕННО не включён: это core-дампы, а не дописываемые
# файлы — ротировать их бессмысленно (ограничение их размера — отдельная задача
# для tmpfiles.d).
/var/log/mplc4/*.log /var/log/mplc4/nginx/*.log {
    weekly
    rotate 4
    size 2M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
