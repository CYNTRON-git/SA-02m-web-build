[Unit]
Description=SA-02m early start (USB power, optional DS3231 RTC, PCA9536 beep)
DefaultDependencies=no
After=systemd-modules-load.service systemd-udevd.service
Before=time-set.target time-sync.target networking.service
Wants=systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/sa02m-pre-start.sh
# Save DS3231 and fake-hwclock on shutdown/reboot with the last known
# (ideally NTP-synced) system time before power is cut.
ExecStop=/usr/local/sbin/sa02m-rtc-sync.sh

[Install]
WantedBy=sysinit.target
