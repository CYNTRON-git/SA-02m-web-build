[Unit]
Description=SA-02m unified home API (LAN and cloud dispatcher)
After=mosquitto.service
Wants=mosquitto.service
ConditionPathExists=/opt/sa02m-alice/sa02m_alice/home/main.py

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/sa02m-alice
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/sa02m-alice:/opt/sa02m-devices:/opt/sa02m-rules
ExecStart=/usr/bin/python3 -m sa02m_alice.home.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
StateDirectory=sa02m-home
StateDirectoryMode=0700
RuntimeDirectory=sa02m-home
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/sa02m-alice /etc/sa02m-rules /var/lib/sa02m-home /run/sa02m-home
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
