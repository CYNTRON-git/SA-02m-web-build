[Unit]
Description=SA-02m audio recorder (one bounded clip from the USB microphone per MQTT command)
# Commands and state go through the local broker; paho reconnects on its own,
# so the broker coming up later is not a start failure.
After=mosquitto.service

[Service]
Type=simple
WorkingDirectory=/opt/sa02m-audio
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/sa02m-audio
# Stdlib + apt python3-paho-mqtt only (no venv, no pip): OTA carries all of it.
ExecStart=/usr/bin/python3 -m sa02m_audio
# enabled=false, an unreadable conf or paho missing -> the daemon writes its
# status and exits 0; a second copy exits 75. Neither is a restart reason.
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=75
# SIGTERM kills arecord's process group and drops the .part well inside this
# (docs/contracts/audio-recorder.md §14); also inside the web trigger's 10 s
# `timeout systemctl stop`.
TimeoutStopSec=8s
# Resource ceiling on a SoC shared with CODESYS/MPLC4/mosquitto (plan §11):
# python + paho ~14 MB on the bench, arecord ~7 MB while recording.
MemoryMax=48M
CPUQuota=25%
TasksMax=16
# Unprivileged, and NOT group www-data (that group reads the panel credentials
# and every web conf). `audio` is the one extra group: /dev/snd/* is
# root:audio 0660 (bench 1.135). Its one home is this line — the installer
# adds no membership (gate `daemon-least-privilege`). The eMMC store and
# /run/sa02m-audio are setgid www-data 2750, so the CGI reads what the daemon
# writes without the daemon being in that group; the conf dir is
# www-data:sa02m-audio 2750 (read-only for the daemon).
User=sa02m-audio
Group=sa02m-audio
SupplementaryGroups=audio
# `+`: as root, before the sandbox; `-`: never a start failure — a failed probe
# is in this unit's journal and the daemon then reports `conf_unreadable`.
ExecStartPre=-+/usr/local/sbin/sa02m-daemon-access.sh apply audio
# Files the daemon creates: group from the setgid dir, read for that group only.
UMask=0027
NoNewPrivileges=true
# strict: /etc (including the conf) is read-only. Writable: the eMMC store,
# /run/sa02m-audio, the mic lease in /run/lock, and the two removable mount
# points (`-`: absent is not a start failure). Bench 1.135, 2026-10-15: a
# medium mounted on /media/usb AFTER a unit like this one started was visible
# and writable inside it (mount propagation), so no ProtectSystem fallback.
ProtectSystem=strict
ReadWritePaths=/var/lib/sa02m-audio /run/sa02m-audio /run/lock -/media/usb -/media/sdcard
ProtectHome=true
PrivateTmp=true
# The microphone is a character device: PrivateDevices would hide it. Closed
# device policy instead — only ALSA (bench 1.135: arecord works this way).
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=char-alsa rw
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# The local broker only; no listener, no netlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
