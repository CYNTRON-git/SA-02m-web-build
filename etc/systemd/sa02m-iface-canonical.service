[Unit]
Description=SA-02m: canonical Ethernet interface names (end0/end1 -> eth0/eth1)
Documentation=file:/usr/local/sbin/sa02m-iface-canonical.sh
# Ordering vs udev: After= (no Wants=) — on the 6.1 bench board a pulled-in
# systemd-udev-settle times out at 120 s EVERY boot (busy queue, cause in the
# backlog), costing ~2 min of boot and a failed unit for zero benefit: the
# script's own bounded device-wait (10 s, per pair) is the primary mechanism,
# exactly as the plan designed it. If something else pulls settle in, we still
# order after it; if nothing does, we don't pay for it.
DefaultDependencies=no
After=systemd-udev-settle.service
# The hard requirement: ifup must not run against a stale name (the 1.0.3.38
# "Cannot find device" symptom). network-pre.target is the idiomatic anchor,
# kept as a second ordering path should a future ifupdown drop the direct edge.
# fix-eth.service binds sys-subsystem-net-devices-eth0.device and
# sa02m-eth1-coldboot.service tests for eth1.conf — both must see the settled
# name. Before= is ORDERING ONLY: a failed run never blocks the network.
Before=network-pre.target networking.service fix-eth.service sa02m-eth1-coldboot.service
Wants=network-pre.target
# DefaultDependencies=no drops these; re-add them explicitly.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/sa02m-iface-canonical.sh
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sa02m-iface-canonical

[Install]
WantedBy=multi-user.target
