[Unit]
Description=SA-02m update post-boot verification (health gate after recover)
Documentation=file:///usr/local/libexec/sa02m-update-runner
# Static on purpose (no [Install]): sa02m-update-recover.service starts it only
# when a complete-but-unverified tree is found at boot. Recover is ordered
# Before=nginx fcgiwrap, so the health gate cannot run there; it runs here,
# after the web stack, and rolls back only on a real failure.
After=sa02m-update-recover.service nginx.service fcgiwrap.service sa02m-devices-api.service network.target sa02m-port-coordinator.service sa02m-flasher.service sa02m-modbus-mqtt.service sa02m-serial-gateway.service
Conflicts=sa02m-update.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/sa02m-update-runner verify
TimeoutStartSec=900
Nice=5
