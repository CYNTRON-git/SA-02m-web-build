# SA-02m web panel — the COMPLETE, single-home sudoers grant for www-data.
#
# Installed WHOLESALE (install -m 0440) by scripts/03-webserver.sh and
# scripts/update-www-only.sh via sa02m_install_sudoers, and by the offline path
# (which re-runs install.sh -> 03-webserver.sh). Because it is installed as one
# file, a re-run OVERWRITES any older drop-in and REMOVES a stale dangerous
# grant — convergence + idempotency by construction (no heredoc, no
# append-if-missing, no .fragment to drift). sa02m_harden_sudoers runs
# `visudo -cf` on every write.
#
# SECURITY (audit B1): www-data holds ONLY pinned helpers and fixed argument
# vectors. It has NO raw tee, ifup/ifdown, kill, i2cset/i2cget or
# gpioset/gpioget — an authenticated web session can no longer reach root
# without the device root password. Root file-write is pinned to two helpers
# (sa02m-iface-conf-write.sh, sa02m-usb-power.sh) and ifup/ifdown to the four
# LAN names. Threat model: docs/threat-model.md (A1/A2/A5->S2 row).

# ── Clock (set-only; no file-write / no exec — clock DoS at worst) ──────────
www-data ALL=(ALL) NOPASSWD: /bin/date, /usr/bin/date, /sbin/hwclock, /usr/sbin/hwclock, /usr/bin/timedatectl

# ── Network: pinned interface conf write + fixed ifup/ifdown vectors ────────
# The conf write goes through the pinned helper (four-name allow-list, symlink
# refusal, content from stdin). ifup/ifdown are argument-pinned to the four LAN
# names, which closes the `-i <file>` / pre-up-stanza root-exec vector.
www-data ALL=(ALL) NOPASSWD: /usr/local/sbin/sa02m-iface-conf-write.sh
www-data ALL=(ALL) NOPASSWD: /usr/local/sbin/sa02m-ensure-eth1-dhcp-hook.sh
www-data ALL=(ALL) NOPASSWD: /sbin/ifup eth0, /sbin/ifup eth1, /sbin/ifup end0, /sbin/ifup end1
www-data ALL=(ALL) NOPASSWD: /sbin/ifdown eth0, /sbin/ifdown eth1, /sbin/ifdown end0, /sbin/ifdown end1

# ── Reboot / restart (argument-bounded; no arbitrary exec) ──────────────────
www-data ALL=(ALL) NOPASSWD: /sbin/reboot, /usr/sbin/reboot, /usr/bin/reboot, \
    /sbin/reboot -f, /usr/sbin/reboot -f, /usr/bin/reboot -f, \
    /sbin/shutdown -r now, /usr/sbin/shutdown -r now, \
    /usr/bin/systemctl reboot, \
    /usr/bin/systemctl restart nginx, /usr/bin/systemctl restart fcgiwrap, \
    /usr/bin/systemctl restart networking, /usr/bin/systemctl restart networking.service, \
    /usr/bin/systemctl restart fix-eth.service

# ── HW: discrete out / beeper / alarm-LED / USB-power ───────────────────────
# I2C (PCA9536) goes through group `i2c` (www-data is a member; /dev/i2c-* are
# group-rw) — NO sudo grant. GPIO / USB-power go through the pinned helper (a
# closed verb set, config-validated pins/lines, internal cmdline-verified kill).
www-data ALL=(ALL) NOPASSWD: /usr/local/sbin/sa02m-usb-power.sh *

# ── Storage / web-update / factory-reset / backup ───────────────────────────
www-data ALL=(ALL) NOPASSWD: /usr/local/sbin/sa02m-set-storage-auto-format, \
    /usr/local/sbin/sa02m-web-update-check, \
    /usr/local/sbin/sa02m-web-update-apply, \
    /usr/bin/systemctl start sa02m-update.service, \
    /usr/bin/systemctl stop sa02m-update.service, \
    /usr/bin/systemctl reset-failed sa02m-update.service, \
    /usr/bin/systemctl start sa02m-factory-reset.service, \
    /usr/local/libexec/sa02m-update-inspect, \
    /usr/local/sbin/sa02m-web-backup.sh, \
    /usr/local/sbin/sa02m-web-reboot.sh, \
    /usr/local/sbin/sa02m-web-restart-services.sh

# ── Service control (fixed verbs; unit name behind the helper's allow-list) ──
www-data ALL=(ALL) NOPASSWD: /usr/local/sbin/sa02m-web-service-ctl.sh list, \
    /usr/local/sbin/sa02m-web-service-ctl.sh start *, \
    /usr/local/sbin/sa02m-web-service-ctl.sh stop *, \
    /usr/local/sbin/sa02m-web-service-ctl.sh install *, \
    /usr/local/sbin/sa02m-web-service-ctl.sh uninstall *

# ── RS-485 stats / kernel select / CPU profile / MPLC deploy / creds ────────
www-data ALL=(ALL) NOPASSWD: /usr/local/sbin/sa02m-rs485-stats.sh, \
    /usr/local/sbin/sa02m-kernel-select.sh status --json, \
    /usr/local/sbin/sa02m-kernel-select.sh set smp, \
    /usr/local/sbin/sa02m-kernel-select.sh set rt, \
    /usr/local/sbin/sa02m-kernel-select.sh refresh, \
    /usr/local/sbin/sa02m-set-cpu-profile, \
    /usr/local/sbin/sa02m-cpu-profile.sh status --json, \
    /usr/local/sbin/sa02m-cpu-profile.sh apply, \
    /usr/local/sbin/sa02m-web-root-cmd.sh *, \
    /usr/local/sbin/sa02m-mplc-project-deploy.sh *, \
    /usr/local/sbin/sa02m-conf-rm.sh, \
    /usr/local/sbin/sa02m-commit-web-env
