# ═══════════════════════════════════════════════════════════════════════════
# 99-lan-recovery.rules  —  udev: запуск восстановления сети при появлении
# ethernet-интерфейса (физическое подключение кабеля или привязка драйвера).
#
# ВАЖНО:
#   --no-block обязателен: без него udev ждёт завершения systemctl,
#              что вызывает дедлок (udev сам заблокирован).
#   Используем template-unit fix-eth@.service, чтобы надёжно передать имя
#   интерфейса через instance (%I) и не зависеть от окружения udev/systemd.
# ═══════════════════════════════════════════════════════════════════════════

# end0 — основной интерфейс
ACTION=="add", SUBSYSTEM=="net", KERNEL=="end0", RUN+="/usr/bin/systemctl --no-block start fix-eth@end0.service"
ACTION=="bind", SUBSYSTEM=="net", KERNEL=="end0", RUN+="/usr/bin/systemctl --no-block start fix-eth@end0.service"
# При boot PHY может подняться с задержкой или после краткого link flap.
# Ловим carrier=1, чтобы восстановление шло сразу при реальном link-up.
ACTION=="change", SUBSYSTEM=="net", KERNEL=="end0", ATTR{carrier}=="1", RUN+="/usr/bin/systemctl --no-block start fix-eth@end0.service"
# Восстанавливаем LED trigger при каждом carrier=1: PHY driver сбрасывает его
# в [none] при link-up после bounce или физического переподключения кабеля.
ACTION=="change", SUBSYSTEM=="net", KERNEL=="end0", ATTR{carrier}=="1", RUN+="/usr/local/bin/sa02m-eth0-led.sh"

# end1 — второй интерфейс (если сконфигурирован)
ACTION=="add", SUBSYSTEM=="net", KERNEL=="end1", RUN+="/usr/bin/systemctl --no-block start fix-eth@end1.service"
ACTION=="bind", SUBSYSTEM=="net", KERNEL=="end1", RUN+="/usr/bin/systemctl --no-block start fix-eth@end1.service"
ACTION=="change", SUBSYSTEM=="net", KERNEL=="end1", ATTR{carrier}=="1", RUN+="/usr/bin/systemctl --no-block start fix-eth@end1.service"
